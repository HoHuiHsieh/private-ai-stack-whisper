# Speaches (faster-whisper) settings. Non-secret; the service has no API key.
# Models are chosen per request ("model" field) and downloaded on first use from Hugging Face.
# Speaches reads nested settings as WHISPER__<NAME> (double underscore).

# Run inference on the GPU ("cuda") or CPU ("cpu"). The compose file reserves an NVIDIA GPU,
# so use "cuda". Use "cpu" only on a host without a GPU, and only after the compose file is changed to match.
WHISPER__INFERENCE_DEVICE=cuda
